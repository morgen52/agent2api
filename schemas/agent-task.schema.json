{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent2api.dev/schemas/agent-task.schema.json",
  "title": "Agent Task Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["task"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "agent-service/v1",
      "default": "agent-service/v1"
    },
    "kind": {
      "type": "string",
      "const": "agent.task",
      "default": "agent.task"
    },
    "agent": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "runtime": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "capabilities": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "default": []
            }
          }
        }
      ],
      "default": "codex"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal"],
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "mode": {
          "type": "string",
          "enum": ["execute", "plan", "review", "research", "transform", "question_answer"],
          "default": "execute"
        },
        "instructions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    },
    "context": {
      "$ref": "#/$defs/context",
      "default": { "files": [], "urls": [], "notes": [] }
    },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/skill" },
      "default": []
    },
    "deliverables": {
      "type": "array",
      "items": { "$ref": "#/$defs/deliverable" },
      "default": []
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["sync", "async"], "default": "sync" },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 3600000, "default": 300000 },
        "sandbox": {
          "type": "string",
          "enum": ["read-only", "workspace-write", "danger-full-access"],
          "default": "workspace-write"
        },
        "webSearch": { "type": "boolean", "default": false },
        "model": { "type": "string", "minLength": 1, "maxLength": 120 },
        "profile": { "type": "string", "minLength": 1, "maxLength": 120 }
      },
      "default": { "mode": "sync", "timeoutMs": 300000, "sandbox": "workspace-write", "webSearch": false }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "adapterOptions": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/file" },
          "default": []
        },
        "urls": {
          "type": "array",
          "items": { "$ref": "#/$defs/url" },
          "default": []
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      },
      "default": { "files": [], "urls": [], "notes": [] }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mimeType"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^/\\\\]+$"
        },
        "mimeType": { "type": "string", "minLength": 1 },
        "contentBase64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "text": { "type": "string" }
      },
      "anyOf": [{ "required": ["contentBase64"] }, { "required": ["text"] }]
    },
    "url": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "required": { "type": "boolean", "default": false },
        "inputs": { "type": "object", "additionalProperties": true, "default": {} },
        "permissions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "type": {
          "type": "string",
          "enum": ["document", "image", "audio", "video", "archive", "data", "code", "other"],
          "default": "other"
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "required": { "type": "boolean", "default": false },
        "mimeTypes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    }
  }
}
