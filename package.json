{
  "name": "agent2api",
  "version": "0.1.0",
  "private": false,
  "description": "Agent Task Protocol gateway for running local command-line agents behind an HTTP API.",
  "license": "MIT",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./sdk": {
      "types": "./dist/src/sdk/client.d.ts",
      "import": "./dist/src/sdk/client.js"
    },
    "./schema": "./schemas/agent-task.schema.json"
  },
  "files": [
    "dist",
    "schemas",
    "docs",
    "examples",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/morgen52/agent2api.git"
  },
  "bugs": {
    "url": "https://github.com/morgen52/agent2api/issues"
  },
  "homepage": "https://github.com/morgen52/agent2api#readme",
  "keywords": [
    "agent",
    "gateway",
    "codex",
    "task-protocol",
    "automation",
    "artifacts"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/src/server/index.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check:examples": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext examples/sdk-client.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.0.0",
    "fastify": "^5.6.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
